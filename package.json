{
  "name": "ascii-full",
  "version": "1.4.0",
  "description": "Offline full-fps 24-bit truecolor ASCII video transcoder with a separate multitrack audio lane — CLI, terminal, browser, desktop GUI, portable bundles and one-link HTTPS tunnels (ffmpeg + Node, zero runtime deps)",
  "bin": {
    "ascii-full": "bin/ascii-full.js",
    "ascii-full-term": "bin/ascii-full-term.js",
    "ascii-full-serve": "bin/serve.js",
    "ascii-full-tunnel": "bin/tunnel.js",
    "ascii-full-attach-audio": "bin/attach-audio.js"
  },
  "files": [
    "bin/",
    "web/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/smoke.js",
    "sample": "bash examples/make-sample.sh",
    "serve": "node bin/serve.js",
    "tunnel": "node bin/tunnel.js",
    "attach-audio": "node bin/attach-audio.js",
    "desktop": "npm --prefix desktop start",
    "banner": "node bin/banner.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ascii",
    "ascii-art",
    "video",
    "ffmpeg",
    "truecolor",
    "terminal",
    "offline",
    "cli",
    "electron",
    "desktop",
    "portable",
    "ascii-banner",
    "cloudflare-tunnel",
    "localhost",
    "audio",
    "opus",
    "multitrack",
    "audio-sync"
  ],
  "license": "MIT",
  "private": false
}
