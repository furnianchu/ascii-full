{
  "name": "ascii-full",
  "version": "1.3.0",
  "description": "Offline full-fps 24-bit truecolor ASCII video transcoder — CLI, terminal, browser, desktop GUI, portable bundles and one-link HTTPS tunnels (ffmpeg + Node, zero runtime deps)",
  "bin": {
    "ascii-full": "bin/ascii-full.js",
    "ascii-full-term": "bin/ascii-full-term.js",
    "ascii-full-serve": "bin/serve.js",
    "ascii-full-tunnel": "bin/tunnel.js"
  },
  "files": [
    "bin/",
    "web/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.js",
    "sample": "bash examples/make-sample.sh",
    "serve": "node bin/serve.js",
    "tunnel": "node bin/tunnel.js",
    "desktop": "npm --prefix desktop start",
    "banner": "node bin/banner.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ascii",
    "ascii-art",
    "video",
    "ffmpeg",
    "truecolor",
    "terminal",
    "offline",
    "cli",
    "electron",
    "desktop",
    "portable",
    "ascii-banner",
    "cloudflare-tunnel",
    "localhost"
  ],
  "license": "MIT",
  "private": false
}
